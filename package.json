{
  "name": "lithograph",
  "productName": "Lithograph",
  "version": "0.1.0",
  "description": "A portable, offline C/C++ code editor.",
  "author": "Jatin Aggarwal",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "rebuild-native": "electron-rebuild -f -w node-pty",
    "fetch-clangd": "node scripts/build-main.mjs && node dist/main/fetch-clangd.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && electron . --smoke samples/tinyhttp"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/cpp": "1.1.6",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "elkjs": "0.12.0",
    "node-pty": "1.1.0",
    "smol-toml": "1.9.1",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "22.20.5",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-solid": "2.11.14",
    "vitest": "3.2.7"
  }
}
